# ─── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# ─── Admin credentials ─────────────────────────────────────────
ADMIN_USERNAME=vaishnavi
ADMIN_PASSWORD=your_secure_password_here

# ─── Database (Turso / libSQL) ─────────────────────────────────
# Leave BOTH blank for local development — it falls back to a local
# SQLite file at backend/data/portfolio.db.
# For production persistence, create a free DB at https://turso.tech
# and paste the values from `turso db show` / `turso db tokens create`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Social / Contact ──────────────────────────────────────────
LINKEDIN_URL=https://linkedin.com/in/vaishnavigoyal
GITHUB_URL=https://github.com/vaishnavigoyal
PORTFOLIO_EMAIL=vaishnavi@example.com
